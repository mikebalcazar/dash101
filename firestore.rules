rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function negocioData(negocioId) {
      return get(/databases/$(database)/documents/negocios/$(negocioId)).data;
    }

    // Basic: uid está en miembros_uids del negocio.
    // Este es el patrón "array-contains" que Firestore Rules valida correctamente.
    function isMember(negocioId) {
      return isAuth() && request.auth.uid in negocioData(negocioId).miembros_uids;
    }

    // Owner ORIGINAL del negocio (creador).
    // Simple check contra el campo owner_uid del doc.
    function isOwnerUid(negocioId) {
      return isAuth() && request.auth.uid == negocioData(negocioId).owner_uid;
    }

    // /usuarios/{uid}
    match /usuarios/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && request.auth.uid == uid;
      allow delete: if false;
    }

    // /negocios/{id}
    match /negocios/{negocioId} {
      allow read: if isAuth() && request.auth.uid in resource.data.miembros_uids;

      allow create: if isAuth()
        && request.auth.uid == request.resource.data.owner_uid
        && request.auth.uid in request.resource.data.miembros_uids;

      // update: si soy owner, o si soy invitado aceptando (solo modifico miembros_uids)
      allow update: if isAuth() && (
        (request.auth.uid in resource.data.miembros_uids && request.auth.uid == resource.data.owner_uid)
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros_uids'])
         && request.auth.uid in request.resource.data.miembros_uids)
      );

      allow delete: if isOwnerUid(negocioId);
    }

    // /cuentas/{id}
    match /cuentas/{cuentaId} {
      allow read: if isMember(resource.data.negocio_id);
      allow create: if isMember(request.resource.data.negocio_id);
      allow update: if isMember(resource.data.negocio_id);
      allow delete: if isOwnerUid(resource.data.negocio_id);
    }

    // ---- Portal de clientes (app aparte, solo lectura) ----
    // Un cliente con acceso tiene uid de Firebase Auth. Los docs que puede
    // leer traen ese uid denormalizado en `cliente_uid` (o `uid` en clientes).
    // Lo pone/quita CONTA MASTER al activar/desactivar el acceso. Sin escritura.
    function esClientePortal(uidCampo) {
      return isAuth() && uidCampo != null && request.auth.uid == uidCampo;
    }

    // /clientes/{id}
    match /clientes/{clienteId} {
      allow read: if isMember(resource.data.negocio_id)
        || (esClientePortal(resource.data.uid) && resource.data.portal_activo == true);
      allow create: if isMember(request.resource.data.negocio_id);
      allow update: if isMember(resource.data.negocio_id);
      allow delete: if isOwnerUid(resource.data.negocio_id);
    }

    // /proveedores — catálogo global
    match /proveedores/{proveedorId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.creado_por == request.auth.uid;
      allow delete: if isAuth() && resource.data.creado_por == request.auth.uid;
    }

    // /proyectos/{id}
    match /proyectos/{proyectoId} {
      allow read: if isMember(resource.data.negocio_id)
        || esClientePortal(resource.data.cliente_uid);
      allow create: if isMember(request.resource.data.negocio_id);
      allow update: if isMember(resource.data.negocio_id);
      allow delete: if isOwnerUid(resource.data.negocio_id);
    }

    // /movimientos/{id}
    match /movimientos/{movimientoId} {
      allow read: if isMember(resource.data.negocio_id)
        || esClientePortal(resource.data.cliente_uid);
      allow create: if isMember(request.resource.data.negocio_id);
      allow update: if isMember(resource.data.negocio_id);
      allow delete: if isMember(resource.data.negocio_id);
    }

    // /opex/{id}
    match /opex/{opexId} {
      allow read: if isMember(resource.data.negocio_id);
      allow create: if isMember(request.resource.data.negocio_id);
      allow update: if isMember(resource.data.negocio_id);
      allow delete: if isMember(resource.data.negocio_id);
    }

    // /invitaciones/{id}
    match /invitaciones/{invId} {
      // Read público: el invitado (aún no autenticado) necesita ver detalles.
      // IDs son UUIDs no adivinables → seguridad por obscuridad aceptable.
      allow read: if true;

      allow create: if isOwnerUid(request.resource.data.negocio_id)
        && request.resource.data.invited_by_uid == request.auth.uid;

      allow update: if isAuth() && (
        isOwnerUid(resource.data.negocio_id)
        ||
        (request.auth.token.email.lower() == resource.data.email
         && request.resource.data.estado in ['aceptada', 'expirada'])
      );

      allow delete: if isOwnerUid(resource.data.negocio_id);
    }

    // Deny todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
