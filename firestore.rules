rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function negocioData(negocioId) {
      return get(/databases/$(database)/documents/negocios/$(negocioId)).data;
    }

    function isMember(negocioId) {
      return isAuth() && request.auth.uid in negocioData(negocioId).miembros_uids;
    }

    function isOwnerOfNegocio(negocioId) {
      return isAuth() && request.auth.uid == negocioData(negocioId).owner_uid;
    }

    // /usuarios/{uid}
    match /usuarios/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && request.auth.uid == uid;
      allow delete: if false;
    }

    // /negocios/{id}
    match /negocios/{negocioId} {
      allow read: if isAuth() && request.auth.uid in resource.data.miembros_uids;
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.owner_uid
        && request.auth.uid in request.resource.data.miembros_uids;
      allow update: if isAuth() && request.auth.uid == resource.data.owner_uid;
      allow delete: if isAuth() && request.auth.uid == resource.data.owner_uid;
    }

    // /cuentas/{id}
    match /cuentas/{cuentaId} {
      allow read: if isMember(resource.data.negocio_id);
      allow create: if isAuth() && isMember(request.resource.data.negocio_id);
      allow update: if isMember(resource.data.negocio_id);
      allow delete: if isOwnerOfNegocio(resource.data.negocio_id);
    }

    // /clientes/{id}
    match /clientes/{clienteId} {
      allow read: if isMember(resource.data.negocio_id);
      allow create: if isAuth() && isMember(request.resource.data.negocio_id);
      allow update: if isMember(resource.data.negocio_id);
      allow delete: if isOwnerOfNegocio(resource.data.negocio_id);
    }

    // /proveedores/{id} — catálogo global
    match /proveedores/{proveedorId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // /proyectos/{id} — miembros del negocio
    match /proyectos/{proyectoId} {
      allow read: if isMember(resource.data.negocio_id);
      allow create: if isAuth() && isMember(request.resource.data.negocio_id);
      allow update: if isMember(resource.data.negocio_id);
      allow delete: if isOwnerOfNegocio(resource.data.negocio_id);
    }

    // /movimientos/{id} — miembros del negocio; solo owner puede borrar
    match /movimientos/{movimientoId} {
      allow read: if isMember(resource.data.negocio_id);
      allow create: if isAuth() && isMember(request.resource.data.negocio_id);
      allow update: if isMember(resource.data.negocio_id);
      allow delete: if isOwnerOfNegocio(resource.data.negocio_id);
    }

    // Deny todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
