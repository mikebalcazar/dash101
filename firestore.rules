rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function myMembership(negocioId) {
      return userDoc().memberships[negocioId];
    }

    function hasMembership(negocioId) {
      return isAuth()
        && 'memberships' in userDoc()
        && negocioId in userDoc().memberships;
    }

    function myRol(negocioId) {
      return myMembership(negocioId).get('rol', 'viewer');
    }

    function myScope(negocioId) {
      return myMembership(negocioId).get('scope', 'all');
    }

    function myProyectosAcceso(negocioId) {
      return myMembership(negocioId).get('proyectos_acceso', []);
    }

    function isOwner(negocioId) {
      return hasMembership(negocioId) && myRol(negocioId) == 'owner';
    }

    function canWrite(negocioId) {
      return hasMembership(negocioId) && myRol(negocioId) in ['owner', 'socio'];
    }

    function hasProyectoAccess(proyectoId, negocioId) {
      return hasMembership(negocioId) && (
        myScope(negocioId) == 'all' ||
        (proyectoId != null && myProyectosAcceso(negocioId).hasAny([proyectoId]))
      );
    }

    function canWriteProyecto(proyectoId, negocioId) {
      return canWrite(negocioId) && (
        myScope(negocioId) == 'all' ||
        (proyectoId != null && myProyectosAcceso(negocioId).hasAny([proyectoId]))
      );
    }

    // /usuarios/{uid}
    match /usuarios/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create: if isAuth() && request.auth.uid == uid;
      allow update: if isAuth() && request.auth.uid == uid;
      allow delete: if false;
    }

    // /negocios/{id}
    match /negocios/{negocioId} {
      allow read: if isAuth() && request.auth.uid in resource.data.miembros_uids;

      allow create: if isAuth()
        && request.auth.uid == request.resource.data.owner_uid
        && request.auth.uid in request.resource.data.miembros_uids;

      // update: si soy owner, o si soy invitado aceptando (solo modifico miembros_uids)
      allow update: if isAuth() && (
        (request.auth.uid in resource.data.miembros_uids && isOwner(negocioId))
        ||
        // Aceptando invitación
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros_uids'])
         && request.auth.uid in request.resource.data.miembros_uids)
      );

      allow delete: if isOwner(negocioId);
    }

    // /cuentas/{id}
    match /cuentas/{cuentaId} {
      allow read: if hasMembership(resource.data.negocio_id);
      allow create: if canWrite(request.resource.data.negocio_id);
      allow update: if canWrite(resource.data.negocio_id);
      allow delete: if isOwner(resource.data.negocio_id);
    }

    // /clientes/{id}
    match /clientes/{clienteId} {
      allow read: if hasMembership(resource.data.negocio_id);
      allow create: if hasMembership(request.resource.data.negocio_id);
      allow update: if canWrite(resource.data.negocio_id);
      allow delete: if isOwner(resource.data.negocio_id);
    }

    // /proveedores — catálogo global
    match /proveedores/{proveedorId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.creado_por == request.auth.uid;
      allow delete: if isAuth() && resource.data.creado_por == request.auth.uid;
    }

    // /proyectos/{id}
    match /proyectos/{proyectoId} {
      allow read: if hasProyectoAccess(proyectoId, resource.data.negocio_id);
      allow create: if canWrite(request.resource.data.negocio_id);
      allow update: if canWriteProyecto(proyectoId, resource.data.negocio_id);
      allow delete: if isOwner(resource.data.negocio_id);
    }

    // /movimientos/{id}
    match /movimientos/{movimientoId} {
      allow read: if hasMembership(resource.data.negocio_id) && (
        myScope(resource.data.negocio_id) == 'all' ||
        (resource.data.proyecto_id != null &&
         myProyectosAcceso(resource.data.negocio_id).hasAny([resource.data.proyecto_id]))
      );

      allow create: if canWrite(request.resource.data.negocio_id) && (
        myScope(request.resource.data.negocio_id) == 'all' ||
        (request.resource.data.proyecto_id != null &&
         myProyectosAcceso(request.resource.data.negocio_id).hasAny([request.resource.data.proyecto_id]))
      );

      allow update: if canWrite(resource.data.negocio_id);
      allow delete: if canWrite(resource.data.negocio_id);
    }

    // /opex/{id}
    match /opex/{opexId} {
      allow read: if hasMembership(resource.data.negocio_id);
      allow create: if canWrite(request.resource.data.negocio_id);
      allow update: if canWrite(resource.data.negocio_id);
      allow delete: if canWrite(resource.data.negocio_id);
    }

    // /invitaciones/{id}
    match /invitaciones/{invId} {
      allow read: if isAuth();

      allow create: if isOwner(request.resource.data.negocio_id)
        && request.resource.data.invited_by_uid == request.auth.uid;

      allow update: if isAuth() && (
        isOwner(resource.data.negocio_id)
        ||
        (request.auth.token.email.lower() == resource.data.email
         && request.resource.data.estado in ['aceptada', 'expirada'])
      );

      allow delete: if isOwner(resource.data.negocio_id);
    }

    // Deny todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
