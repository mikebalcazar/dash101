# Firebase web config — sacalo de Project Settings > Your apps > SDK setup
# Copia este archivo a .env.local y rellena los valores
# En Netlify: Site settings > Environment variables (mismas keys)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_PORTAL_URL=

# Fase 3 de la migración: de dónde lee la app. Se decide al construir.
#   firestore  (o vacío) lo de siempre
#   api        suite101-api por /s101/ (Netlify o el Worker reenvían); entonces
#              hace falta NEXT_PUBLIC_ORG con el id de la empresa (forespot, demo)
NEXT_PUBLIC_FUENTE=
NEXT_PUBLIC_ORG=
# Sólo para las pruebas de node, que no tienen proxy: el Worker directo.
NEXT_PUBLIC_API_ORIGEN=
